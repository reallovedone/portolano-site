---
import Icon from "./Icon.astro";
import type { ProtocolKind } from "../content/copy";

interface Props {
  kind: ProtocolKind;
  name: string;
  port: string;
  text: string;
  class?: string;
}
const { kind, name, port, text, class: className } = Astro.props;
---

<article class:list={["card", `kind-${kind}`, className]}>
  <span class="route" aria-hidden="true"><span class="route-dot"></span></span>
  <span class="kind-icon"><Icon name={kind} size="lg" /></span>
  <h3 class="t-h3">{name}</h3>
  <p class="port">{port}</p>
  <p class="text">{text}</p>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--web-card-pad);
    background: var(--surface-content);
    border: var(--web-hairline) solid var(--border-hairline);
    border-radius: var(--radius-panel);
    transition: border-color var(--duration-base) var(--ease-standard);
  }
  .card:hover {
    border-color: var(--border-strong);
  }
  /* Hairline route along the top edge, traced on hover / focus-within; a small dot travels it.
     The dot's carrier is as wide as the track and slides by its own width (transform only). */
  .route {
    position: absolute;
    inset-inline: var(--radius-panel);
    inset-block-start: calc(var(--web-hairline) * -1);
    block-size: var(--web-hairline);
    pointer-events: none;
  }
  .route::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--protocol-color);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--web-card-route-trace) var(--ease-out);
  }
  .route-dot {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translateX(-100%);
  }
  .route-dot::after {
    content: "";
    position: absolute;
    inset-inline-end: 0;
    inset-block-start: calc(50% - var(--web-card-route-dot) / 2);
    inline-size: var(--web-card-route-dot);
    block-size: var(--web-card-route-dot);
    border-radius: var(--radius-full);
    background: var(--protocol-color);
  }
  .card:is(:hover, :focus-within) .route::before {
    transform: scaleX(1);
  }
  .card:is(:hover, :focus-within) .route-dot {
    animation: card-route-dot var(--web-card-route-trace) var(--ease-out) both;
  }
  @keyframes card-route-dot {
    from {
      opacity: 1;
      transform: translateX(-100%);
    }
    85% {
      opacity: 1;
    }
    to {
      opacity: 0;
      transform: translateX(0);
    }
  }
  /* Reduced motion: the line is simply there, no travelling dot. */
  @media (prefers-reduced-motion: reduce) {
    .route::before {
      transition: none;
    }
    .card:is(:hover, :focus-within) .route-dot {
      animation: none;
    }
  }
  .kind-icon {
    display: flex;
    color: var(--protocol-color);
    margin-block-end: var(--space-2);
  }
  .kind-ssh {
    --protocol-color: var(--protocol-ssh);
  }
  .kind-rdp {
    --protocol-color: var(--protocol-rdp);
  }
  .kind-vnc {
    --protocol-color: var(--protocol-vnc);
  }
  .kind-web {
    --protocol-color: var(--protocol-web);
  }
  .kind-localShell {
    --protocol-color: var(--protocol-local);
  }
  .port {
    font-family: var(--font-mono);
    font-size: var(--font-size-lg);
    color: color-mix(in srgb, var(--protocol-color), var(--text-primary) var(--web-protocol-text-mix));
    line-height: 1;
    transition: color var(--duration-base) var(--ease-standard);
  }
  .text {
    margin-block-start: var(--space-2);
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--text-secondary);
  }
</style>
