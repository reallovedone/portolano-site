---
import Icon from "./Icon.astro";
import type { ProtocolKind } from "../content/copy";

interface Props {
  kind: ProtocolKind;
  name: string;
  port: string;
  text: string;
  class?: string;
}
const { kind, name, port, text, class: className } = Astro.props;
---

<article class:list={["card", `kind-${kind}`, className]}>
  <span class="kind-icon"><Icon name={kind} size="lg" /></span>
  <h3 class="t-h3">{name}</h3>
  <p class="port">{port}</p>
  <p class="text">{text}</p>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--web-card-pad);
    background: var(--surface-content);
    border: var(--web-hairline) solid var(--border-hairline);
    border-radius: var(--radius-panel);
    transition: border-color var(--duration-base) var(--ease-standard);
  }
  .card:hover {
    border-color: var(--border-strong);
  }
  .kind-icon {
    display: flex;
    color: var(--protocol-color);
    margin-block-end: var(--space-2);
  }
  .kind-ssh {
    --protocol-color: var(--protocol-ssh);
  }
  .kind-rdp {
    --protocol-color: var(--protocol-rdp);
  }
  .kind-vnc {
    --protocol-color: var(--protocol-vnc);
  }
  .kind-web {
    --protocol-color: var(--protocol-web);
  }
  .kind-localShell {
    --protocol-color: var(--protocol-local);
  }
  .port {
    font-family: var(--font-mono);
    font-size: var(--font-size-lg);
    color: color-mix(in srgb, var(--protocol-color), var(--text-primary) var(--web-protocol-text-mix));
    line-height: 1;
    transition: color var(--duration-base) var(--ease-standard);
  }
  .text {
    margin-block-start: var(--space-2);
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--text-secondary);
  }
</style>
