---
// "The vault" diagram: password -> Argon2id -> key in memory wrapping the data key (top row), then the sealed
// vault file -> padlock with its idle ring (bottom row). The markup is the FINAL, complete picture: that is
// what no-JS and reduced-motion visitors see. Once the spotlight script sets data-spotlight-mode="tabs" and
// data-step on the section, CSS alone dims what is ahead, traces the connectors and adds the one-shot effects.
// Strokes are drawn in user units (no non-scaling stroke) so dash traces with pathLength="1" stay exact.
import { spotlights } from "../../content/copy";

const d = spotlights.vault.diagram;
const [unlockTop, unlockBottom] = d.unlock.split(" · ");
---

<svg class="vault" viewBox="0 0 640 360" fill="none" aria-hidden="true" focusable="false">
  <defs>
    <!-- Key glyph, 28 x 12, drawn from its top-left corner. -->
    <g id="vault-key">
      <circle cx="6" cy="6" r="5"></circle>
      <path d="M11 6H27M22 6V10M27 6V10"></path>
    </g>
  </defs>

  <!-- 0. Stretch: master password -> Argon2id -> key held in memory -->
  <g class="s s0 rise" style="--i:0">
    <rect class="box" x="16" y="58" width="120" height="48" rx="6"></rect>
    <text class="txt" x="32" y="87">{d.password}</text>
  </g>
  <path class="ln s s0 trace" style="--i:1" d="M136 82H174M168 77L174 82L168 87" pathLength="1"></path>
  <g class="s s0 rise" style="--i:2">
    <rect class="box hl k0" x="176" y="52" width="160" height="60" rx="6"></rect>
    <text class="txt strong" x="192" y="78">{d.kdf}</text>
    <text class="txt dim small" x="192" y="98">{d.kdfParams}</text>
  </g>
  <path class="ln s s0 trace" style="--i:3" d="M336 82H374M368 77L374 82L368 87" pathLength="1"></path>
  <g class="s s0 rise" style="--i:4">
    <use class="glyph" href="#vault-key" x="392" y="42"></use>
    <text class="txt dim small" x="430" y="52">{d.memoryKey}</text>
    <path class="ln soft" d="M406 58V76"></path>
  </g>

  <!-- 1. Wrap: the key wraps the 256-bit data key -->
  <rect class="ln dashed s s1 rise hl k1" style="--i:0" x="376" y="28" width="248" height="120" rx="10"></rect>
  <g class="s s1 rise" style="--i:1">
    <rect class="box" x="392" y="76" width="216" height="56" rx="8"></rect>
    <use class="glyph" href="#vault-key" x="408" y="98"></use>
    <text class="txt" x="448" y="108">{d.dataKey}</text>
  </g>

  <!-- 2. Seal: XChaCha20-Poly1305 into the vault file; a changed bit is rejected -->
  <path class="ln s s2 trace" style="--i:0" d="M500 148V178H96V206M91 200L96 206L101 200" pathLength="1"></path>
  <text class="txt dim small s s2 rise" style="--i:1" x="112" y="170">{d.cipher}</text>
  <g class="s s2 rise" style="--i:2">
    <rect class="box hl k2" x="16" y="208" width="160" height="104" rx="6"></rect>
    <text class="txt dim small" x="30" y="229">{d.file}</text>
    <path class="ln soft" d="M16 240H176"></path>
    <rect class="bar" x="30" y="256" width="104" height="8" rx="2"></rect>
    <rect class="bar" x="30" y="274" width="78" height="8" rx="2"></rect>
    <rect class="bar" x="30" y="292" width="92" height="8" rx="2"></rect>
  </g>
  <g class="s s2 rise" style="--i:4">
    <rect class="ln soft" x="16" y="326" width="236" height="26" rx="13"></rect>
    <text class="txt dim small" x="32" y="343">{d.tampered}</text>
    <path class="ln soft" d="M128 339H146M141 335L146 339L141 343"></path>
    <g class="rej">
      <path class="ln cross" d="M158 335L166 343M166 335L158 343"></path>
      <text class="txt dim small" x="174" y="343">{d.rejected}</text>
    </g>
  </g>

  <!-- 3. Lock and reopen -->
  <path class="ln s s3 trace" style="--i:0" d="M176 260H408M402 255L408 260L402 265" pathLength="1"></path>
  <g class="s s3 rise" style="--i:1">
    <circle class="track" cx="450" cy="262" r="34"></circle>
    <circle class="ring hl k3" cx="450" cy="262" r="34" pathLength="1" transform="rotate(-90 450 262)"></circle>
    <g class="glyph">
      <rect x="438" y="263" width="24" height="18" rx="3"></rect>
      <path class="shackle" d="M443 263V257A7 7 0 0 1 457 257V263"></path>
    </g>
  </g>
  <text class="txt s s3 rise" style="--i:2" x="450" y="322" text-anchor="middle">{d.lock}</text>
  <g class="s s3 rise" style="--i:3">
    <path class="glyph" d="M505 244A15 15 0 0 1 535 244M510 244A10 10 0 0 1 530 244M515 244A5 5 0 0 1 525 244M520 244V258"></path>
    <text class="txt" x="504" y="280">{unlockTop}</text>
    <text class="txt" x="504" y="298">{unlockBottom}</text>
  </g>
</svg>

<style>
  .vault {
    /* Diagram tokens (user units: the drawing scales with the figure). */
    --vault-stroke: 1.25px;
    --vault-ring-w: 2px;
    --vault-dash: 4 4;
    --vault-text: 13px;
    --vault-text-small: 12px;
    --vault-line: var(--border-strong);
    --vault-soft: var(--border-hairline);
    --vault-lift: 4px;
    --vault-rise: 6px;
    /* One-shot effects: the whole run stays within the 3.5 s step. */
    --vault-reject-delay: 700ms;
    --vault-ring-time: 1800ms;
    --vault-lock-time: 3000ms;
    font-family: var(--font-mono);
    font-size: var(--vault-text);
  }

  .ln,
  .box,
  .glyph,
  .glyph :is(path, circle, rect),
  .track,
  .ring {
    stroke-width: var(--vault-stroke);
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ln {
    stroke: var(--vault-line);
    fill: none;
  }
  .soft {
    stroke: var(--vault-soft);
  }
  .dashed {
    stroke-dasharray: var(--vault-dash);
  }
  .box {
    fill: var(--surface-raised);
    stroke: var(--vault-line);
  }
  .glyph,
  .glyph :is(path, circle, rect) {
    stroke: var(--text-secondary);
    fill: none;
  }
  .bar {
    fill: var(--vault-line);
    stroke: none;
  }
  .cross {
    stroke: var(--text-tertiary);
  }
  .track,
  .ring {
    fill: none;
    stroke-width: var(--vault-ring-w);
  }
  .track {
    stroke: var(--decor-line-strong);
  }
  .ring {
    stroke: var(--vault-line);
    stroke-dasharray: 1 1;
    stroke-dashoffset: 0;
  }
  /* Final state: the shackle is lifted (vault reopened). */
  .shackle {
    transform: translateY(calc(var(--vault-lift) * -1));
  }

  .txt {
    fill: var(--text-secondary);
  }
  .txt.strong {
    fill: var(--text-primary);
  }
  .txt.dim {
    fill: var(--text-tertiary);
  }
  .txt.small {
    font-size: var(--vault-text-small);
  }

  /* ---- Steps: only under the script's attribute; without it the picture above is complete ---- */
  :global(.spotlight[data-spotlight-mode="tabs"]) .s {
    opacity: var(--spotlight-dim-opacity);
  }
  :global(.spotlight[data-spotlight-mode="tabs"]) .rise {
    transform: translateY(var(--vault-rise));
  }
  :global(.spotlight[data-spotlight-mode="tabs"]) .trace {
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
  }
  /* A step shows its parts, and keeps them once passed. */
  :global(.spotlight[data-spotlight-mode="tabs"]:not([data-step="-1"])) .s0,
  :global(.spotlight[data-spotlight-mode="tabs"]:is([data-step="1"], [data-step="2"], [data-step="3"])) .s1,
  :global(.spotlight[data-spotlight-mode="tabs"]:is([data-step="2"], [data-step="3"])) .s2,
  :global(.spotlight[data-spotlight-mode="tabs"][data-step="3"]) .s3 {
    opacity: 1;
  }
  :global(.spotlight[data-spotlight-mode="tabs"]:not([data-step="-1"])) .s0.rise,
  :global(.spotlight[data-spotlight-mode="tabs"]:is([data-step="1"], [data-step="2"], [data-step="3"])) .s1.rise,
  :global(.spotlight[data-spotlight-mode="tabs"]:is([data-step="2"], [data-step="3"])) .s2.rise,
  :global(.spotlight[data-spotlight-mode="tabs"][data-step="3"]) .s3.rise {
    transform: none;
  }
  :global(.spotlight[data-spotlight-mode="tabs"]:not([data-step="-1"])) .s0.trace,
  :global(.spotlight[data-spotlight-mode="tabs"]:is([data-step="1"], [data-step="2"], [data-step="3"])) .s1.trace,
  :global(.spotlight[data-spotlight-mode="tabs"]:is([data-step="2"], [data-step="3"])) .s2.trace,
  :global(.spotlight[data-spotlight-mode="tabs"][data-step="3"]) .s3.trace {
    stroke-dashoffset: 0;
  }

  /* The one accent: the main part of the current step. */
  :global(.spotlight[data-spotlight-mode="tabs"][data-step="0"]) .k0,
  :global(.spotlight[data-spotlight-mode="tabs"][data-step="1"]) .k1,
  :global(.spotlight[data-spotlight-mode="tabs"][data-step="2"]) .k2,
  :global(.spotlight[data-spotlight-mode="tabs"][data-step="3"]) .k3 {
    stroke: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Leaving: short. Entering (rules below): soft, staggered. */
    :global(.spotlight[data-spotlight-mode="tabs"]) .s {
      transition:
        opacity var(--web-duration-fade) var(--ease-standard),
        transform var(--web-duration-fade) var(--ease-standard),
        stroke-dashoffset var(--web-duration-fade) var(--ease-standard);
    }
    :global(.spotlight[data-spotlight-mode="tabs"]) .hl {
      transition: stroke var(--web-duration-fade) var(--ease-standard) var(--spotlight-entry-delay, 0ms);
    }
    :global(.spotlight[data-spotlight-mode="tabs"]) .hl.s {
      transition:
        opacity var(--web-duration-fade) var(--ease-standard),
        transform var(--web-duration-fade) var(--ease-standard),
        stroke var(--web-duration-fade) var(--ease-standard) var(--spotlight-entry-delay, 0ms);
    }
    :global(.spotlight[data-spotlight-mode="tabs"]:not([data-step="-1"])) .s0,
    :global(.spotlight[data-spotlight-mode="tabs"]:is([data-step="1"], [data-step="2"], [data-step="3"])) .s1,
    :global(.spotlight[data-spotlight-mode="tabs"]:is([data-step="2"], [data-step="3"])) .s2,
    :global(.spotlight[data-spotlight-mode="tabs"][data-step="3"]) .s3 {
      transition:
        opacity var(--web-duration-reveal) var(--ease-out) calc(var(--i) * var(--spotlight-stagger) + var(--spotlight-entry-delay, 0ms)),
        transform var(--web-duration-reveal) var(--ease-out) calc(var(--i) * var(--spotlight-stagger) + var(--spotlight-entry-delay, 0ms)),
        stroke-dashoffset var(--web-duration-trace) var(--ease-out) calc(var(--i) * var(--spotlight-stagger) + var(--spotlight-entry-delay, 0ms)),
        stroke var(--web-duration-fade) var(--ease-standard) var(--spotlight-entry-delay, 0ms);
    }

    /* Step 2: after a beat, the altered file is rejected. */
    :global(.spotlight[data-spotlight-mode="tabs"][data-step="2"]) .rej {
      animation: vault-reject var(--web-duration-reveal) var(--ease-out) var(--vault-reject-delay) backwards;
    }
    /* Step 3: the idle ring empties, the shackle closes, then Touch ID / Windows Hello reopens it. */
    :global(.spotlight[data-spotlight-mode="tabs"][data-step="3"]) .ring {
      animation: vault-ring var(--vault-ring-time) var(--ease-standard) var(--spotlight-entry-delay, 0ms) both;
    }
    :global(.spotlight[data-spotlight-mode="tabs"][data-step="3"]) .shackle {
      animation: vault-shackle var(--vault-lock-time) var(--ease-standard) var(--spotlight-entry-delay, 0ms) both;
    }
  }

  @keyframes vault-reject {
    from {
      opacity: 0;
      transform: translateY(var(--vault-rise));
    }
  }
  @keyframes vault-ring {
    from {
      stroke-dashoffset: 0;
    }
    to {
      stroke-dashoffset: 1;
    }
  }
  @keyframes vault-shackle {
    0%,
    58% {
      transform: translateY(calc(var(--vault-lift) * -1));
    }
    70%,
    82% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(calc(var(--vault-lift) * -1));
    }
  }
</style>
