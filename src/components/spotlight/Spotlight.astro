---
import Eyebrow from "../Eyebrow.astro";
import "../../scripts/spotlight/spotlight.css";

interface Props {
  id: string;
  tone?: "content" | "window";
  eyebrow?: string;
  title: string;
  lead?: string;
  steps: { title: string; text: string }[];
  titleId: string;
  diagramLabel: string;
}
const { id, tone = "content", eyebrow, title, lead, steps, titleId, diagramLabel } = Astro.props;
---

<!--
  Spotlight: a compact scene (at most one screen) with four steps next to an inline diagram.

  Markup: the steps are a plain <ol> (title + text each), so without JavaScript, or with reduced
  motion, everything reads as a list and the diagram is complete. src/scripts/spotlight/index.ts then
  turns the list into vertical tabs (narrow: a row of number-only tabs) and sets on the <section>:
    data-spotlight-mode="tabs"   present once enhanced (all hidden/dimmed states live under it)
    data-step="-1"               waiting: the diagram is not yet in view (or left it); nothing reached,
                                 every part dimmed. Once in view it goes straight to 3, complete.
    data-step="0".."3"           the current step; set on every change (entry, click, keys)
    data-entry                   present from that entry until a tab is used or the scene leaves:
                                 each step's parts start --spotlight-entry-step after the previous
                                 step's (diagrams add --spotlight-entry-delay to their entering
                                 transitions and one-shots), so the build-up reads as one pass.
  DIAGRAM CONTRACT: `data-step` on the section is the ONLY thing diagrams may depend on. Diagram CSS
  uses selectors like `[data-spotlight-mode="tabs"][data-step="2"] .x`; with no mode attribute the
  diagram must show its final, complete state. The slot holds one <svg aria-hidden="true">.
-->
<section
  id={id}
  data-spotlight={id}
  class:list={["spotlight", `tone-${tone}`]}
  aria-labelledby={titleId}
>
  <div class="container spotlight-inner">
    <header class="spotlight-head">
      {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
      <h2 id={titleId} class="t-h2">{title}</h2>
      {lead && <p class="t-lead">{lead}</p>}
    </header>
    <figure class="spotlight-stage" role="img" aria-label={diagramLabel}>
      <slot />
    </figure>
    <div class="spotlight-steps">
      <ol class="steps">
        {
          steps.map((step) => (
            <li class="step">
              <h3 class="t-h3">{step.title}</h3>
              <p class="text">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
