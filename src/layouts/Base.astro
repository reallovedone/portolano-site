---
import "../styles/tokens.css";
import "../styles/web.css";
import { meta, service } from "../content/copy";
import { absoluteUrl, OG_IMAGE, serializeJsonLd, SITE_NAME, THEME_COLOR } from "../lib/seo";

interface Props {
  title?: string;
  description?: string;
  /** Emits a canonical link for the current URL. Off for pages that are not indexable (404). */
  canonical?: boolean;
  /** noindex,follow instead of index,follow. */
  noindex?: boolean;
  /** Structured data object, serialised into an application/ld+json script. */
  jsonLd?: object;
}
const { title = meta.title, description = meta.description, canonical = true, noindex = false, jsonLd } = Astro.props;
const site = Astro.site;
if (!site) throw new Error("astro.config.mjs must set `site`");
const pageUrl = absoluteUrl(Astro.url.pathname, site);
const imageUrl = absoluteUrl(OG_IMAGE.path, site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow"} />
    {canonical && <link rel="canonical" href={pageUrl} />}
    <meta name="theme-color" content={THEME_COLOR.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={THEME_COLOR.dark} media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={pageUrl} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(OG_IMAGE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE.height)} />
    <meta property="og:image:alt" content={OG_IMAGE.alt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={OG_IMAGE.alt} />
    {jsonLd && <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}
    <!-- Applies the saved theme before the first paint to avoid a flash of the wrong one. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        try {
          var saved = localStorage.getItem("portolano-theme");
          if (saved === "light" || saved === "dark") root.setAttribute("data-theme", saved);
        } catch (error) {
          root.setAttribute("data-theme-storage", "unavailable");
        }
        root.classList.add("js");
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{service.skipLink}</a>
    <slot />
  </body>
</html>

<style is:global>
  .skip {
    position: absolute;
    inset-block-start: var(--space-2);
    inset-inline-start: var(--space-2);
    z-index: var(--z-toast);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-control);
    background: var(--surface-raised);
    color: var(--text-primary);
    box-shadow: var(--shadow-popover);
    transform: translateY(-300%);
  }
  .skip:focus {
    transform: none;
  }
</style>
